.home1{
    height: 80vh;
    width:80vw;
    background-color:black;
    background-repeat: no-repeat;
    border-radius: 30px;
    background-image: radial-gradient(circle at 20% 20%,rgba(250,100,30,0.9)0%,transparent 40%),
                      radial-gradient(circle at 80% 80%,rgba(30,100,250,0.9)0%,transparent 40%); 
  
    margin:0 auto;
}

.home_container{
    display:flex;
    justify-content: center;
    align-items:center;
    height:90vh;
}

.hometext{
    width:50vw;
}

.navbar{
    display: flex;
    justify-content: space-between;
    color: aliceblue;
    font-size: 20px;
}

.nav{
    color: aliceblue;
    text-decoration: none;
    font-size: 20px;
    margin:15px;
}

.logo{
    width: 25vw;
    margin: 0;
}

.credentials{
    width:25vw;
}

.bar{
    width: 40vw;
    display: flex;
    justify-content: space-evenly;
}

.logo_png{
    height: 60px;
    margin: 0;
    
}